# Copia este archivo como .env.<cuenta> y define un stack distinto en Dokploy por cada cuenta/cliente.

# Postgres (Supabase cloud o self-hosted) — usar el "Connection string" en modo session/transaction pooler
DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# Credenciales de la cuenta de Instagram en Zernio (distintas por cliente)
ZERNIO_API_KEY=
ZERNIO_ACCOUNT_ID=

# Generación de ideas con IA
ANTHROPIC_API_KEY=

# Supabase Auth (Project Settings → API)
SUPABASE_JWT_SECRET=
REACT_APP_SUPABASE_URL=https://xxxxx.supabase.co
REACT_APP_SUPABASE_ANON_KEY=

# Opcionales
DASHBOARD_TZ=America/Mexico_City
CORS_ORIGINS=https://dashboard.tudominio.com

# Frontend (se hornea en build time, requiere rebuild si cambia)
REACT_APP_BACKEND_URL=https://api.tudominio.com
